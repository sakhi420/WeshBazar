# =============================================================================
# WeshBazar API — environment configuration
# Copy this file to `.env` and adjust values for your environment.
# Never commit real secrets.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database ----------------------------------------------------------------
# Application connection (use Neon pooled URL in production).
DATABASE_URL=postgresql://weshbazar:weshbazar@localhost:5432/weshbazar_dev
# Prisma CLI migration connection (use Neon unpooled URL; same local URL in development).
DATABASE_URL_UNPOOLED=postgresql://weshbazar:weshbazar@localhost:5432/weshbazar_dev
# Used by `prisma migrate dev` for shadow-database validation (development only).
SHADOW_DATABASE_URL=postgresql://weshbazar:weshbazar@localhost:5432/weshbazar_shadow
DB_POOL_MAX=10
DB_POOL_CONNECT_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000

# --- Auth secrets ------------------------------------------------------------
# Generate strong random values (>= 32 chars) for anything that is not local.
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789
# Also used as the HMAC pepper for hashing one-time credentials at rest
# (refresh tokens, OTP codes, password-reset codes).
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-0123456789
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Password policy ---------------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false
PASSWORD_REQUIRE_UPPERCASE=false

# --- OTP / verification challenges (seconds unless stated) -------------------
OTP_LENGTH=6
OTP_EXPIRES_IN=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
# Lifetime of a password-reset challenge (seconds).
PASSWORD_RESET_EXPIRES_IN=900

# --- Cookies (web refresh-token transport) -----------------------------------
REFRESH_COOKIE_NAME=weshbazar_refresh
# Leave empty to omit the Domain attribute (recommended for localhost).
COOKIE_DOMAIN=
# true in production behind HTTPS.
COOKIE_SECURE=false
# lax | strict | none  (none requires Secure)
COOKIE_SAME_SITE=lax

# --- CORS / proxy / request IDs ----------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# true | false  (enable only behind a trusted reverse proxy)
TRUST_PROXY=false
# Accept client-supplied X-Request-ID headers (never enable in production).
TRUST_REQUEST_ID_HEADER=false

# --- Rate limiting -----------------------------------------------------------
# Default window for the limits below (seconds).
RATE_LIMIT_WINDOW_SECONDS=900
MAX_LOGIN_ATTEMPTS_PER_WINDOW=10
MAX_REGISTER_ATTEMPTS_PER_WINDOW=5
MAX_OTP_SEND_PER_WINDOW=5
MAX_OTP_VERIFY_ATTEMPTS_PER_WINDOW=20
MAX_PASSWORD_RESET_PER_WINDOW=5
MAX_LISTING_CREATE_PER_WINDOW=20
MAX_REPORT_PER_WINDOW=10
MAX_CONTACT_PER_WINDOW=30
MAX_IMAGE_UPLOAD_PER_WINDOW=60
MAX_SEARCH_PER_WINDOW=120
# Cap on views counted into analytics per client per view-dedupe window (§73).
MAX_LISTING_VIEWS_PER_WINDOW=200

# --- Account lockout ---------------------------------------------------------
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_SECONDS=900

# --- Storage / media ---------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./var/storage
# Base URL used to build public URLs for locally stored media.
PUBLIC_STORAGE_BASE_URL=http://localhost:3000
# Required only when STORAGE_PROVIDER=neon. Use credentials from Neon Object Storage.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_BUCKET=
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE=5242880
MAX_IMAGES_PER_LISTING=10
MAX_IMAGE_PIXELS=25000000
ORPHAN_MEDIA_RETENTION_DAYS=7

# --- Listing / marketplace limits --------------------------------------------
MIN_LISTING_TITLE_LENGTH=10
MAX_LISTING_TITLE_LENGTH=120
MIN_LISTING_DESCRIPTION_LENGTH=30
MAX_LISTING_DESCRIPTION_LENGTH=5000
MAX_LISTING_ATTRIBUTES=30
MAX_LISTING_FILTERS=8
MAX_ACTIVE_LISTINGS_PER_USER=50
MAX_PENDING_LISTINGS_PER_USER=10
LISTING_EXPIRES_AFTER_DAYS=30
STALE_DRAFT_ARCHIVE_AFTER_DAYS=30
VIEW_DEDUPE_WINDOW_SECONDS=43200

# --- Background jobs (§69) ---------------------------------------------------
# Master switch for the in-process scheduler; disable to run API-only instances.
JOBS_ENABLED=true
# Maximum rows each bounded job pass processes (and max files per media pass).
JOBS_BATCH_SIZE=100
# Seconds between runs of each job (each tick processes up to JOBS_BATCH_SIZE).
JOBS_EXPIRE_LISTINGS_INTERVAL_SECONDS=300
JOBS_ARCHIVE_STALE_DRAFTS_INTERVAL_SECONDS=3600
JOBS_CLEAN_CHALLENGES_INTERVAL_SECONDS=3600
JOBS_CLEAN_SESSIONS_INTERVAL_SECONDS=3600
JOBS_CLEAN_ORPHAN_MEDIA_INTERVAL_SECONDS=21600
# Archived-listing image cleanup — opt-in and dry-run by default; flip both
# explicitly only after the rollout is signed off (§5.17 Runbook).
JOBS_CLEAN_ARCHIVED_LISTING_IMAGES_ENABLED=false
JOBS_CLEAN_ARCHIVED_LISTING_IMAGES_DRY_RUN=true
JOBS_CLEAN_ARCHIVED_LISTING_IMAGES_INTERVAL_SECONDS=21600
# How long to keep archived listings' images before they may be claimed (days).
ARCHIVED_IMAGE_RETENTION_DAYS=30
# Grace on top of expiresAt before verification challenges are deleted (days).
JOBS_CHALLENGE_RETENTION_DAYS=1
# Grace on top of expiresAt before refresh sessions are deleted (days);
# keeps a recent reuse-detection trail.
JOBS_REFRESH_SESSION_RETENTION_DAYS=30
# The expiration runway (LISTING_EXPIRES_AFTER_DAYS), stale-draft TTL
# (STALE_DRAFT_ARCHIVE_AFTER_DAYS) and media retention
# (ORPHAN_MEDIA_RETENTION_DAYS) are configured in their own sections above.

# --- Providers ---------------------------------------------------------------
# mock | http | disabled (disabled prevents OTP delivery; exhibition/read-only use only)
SMS_PROVIDER=mock
# noop | (future: AI moderation provider)
MODERATION_PROVIDER=noop

# --- SMS gateway (required only when SMS_PROVIDER=http) -----------------------
# Absolute http(s) endpoint of the chosen aggregator.
SMS_GATEWAY_URL=
# API key/secret the aggregator expects.
SMS_GATEWAY_API_KEY=
# HTTP header that carries the key (e.g. X-Api-Key or Authorization).
SMS_GATEWAY_API_KEY_HEADER=X-Api-Key
# Optional prefix prepended to the key value (e.g. "Bearer ").
SMS_GATEWAY_API_KEY_PREFIX=
# Optional sender ID / short-code shown to recipients (omit if not supported).
SMS_GATEWAY_SENDER=
# Per-attempt timeout (ms) and retry count.
SMS_GATEWAY_TIMEOUT_MS=10000
SMS_GATEWAY_MAX_RETRIES=2
# Dari message template; {code} is replaced with the verification code.
SMS_MESSAGE_TEMPLATE=وزبازار: کد تأیید شما {code} است

# --- Logging / docs ----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
SWAGGER_ENABLED=true

# --- Development seed (never used in production) -----------------------------
SEED_ADMIN_PHONE=+93700000000
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=WeshBazar Admin
SEED_SAMPLE_DATA=false
