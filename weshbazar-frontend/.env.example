# ---------------------------------------------------------------------------
# WeshBazar frontend environment
# Copy to .env.local and adjust. Never commit real secrets.
# Backend contract: weshbazar-backend/docs/frontend-api-contract.md
# ---------------------------------------------------------------------------

# Public base URL for *browser* API requests (no /api/v1 suffix here).
# Leave empty for the same-origin reverse proxy: Next.js rewrites /api/v1/* to
# the backend (next.config.mjs `rewrites`), which removes CORS permanently.
NEXT_PUBLIC_API_BASE_URL=

# API prefix applied to all routes except /health/*. (frontend-api-contract.md §1)
NEXT_PUBLIC_API_PREFIX=/api/v1

# Absolute public base URL for stored media/images (dev serving: /media/<key>).
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:3000

# Public site URL used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only: base URL used by React Server Components to call the API.
# Defaults to NEXT_PUBLIC_API_BASE_URL when unset.
API_SERVER_BASE_URL=http://localhost:3000
