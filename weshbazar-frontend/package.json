{
  "name": "@weshbazar/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "WeshBazar marketplace frontend — Next.js App Router, RTL fa-AF, mobile-first.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/download-welcome-images.mjs --allow-missing && next dev -p 3001",
    "build": "next build",
    "analyze": "node scripts/download-welcome-images.mjs && set ANALYZE=true && next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "prebuild": "node scripts/download-welcome-images.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-slot": "1.1.1",
    "@tanstack/react-query": "5.64.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "next": "15.5.29",
    "nuqs": "2.2.3",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "react-hook-form": "7.54.2",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "15.5.29",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.7.3"
  }
}
